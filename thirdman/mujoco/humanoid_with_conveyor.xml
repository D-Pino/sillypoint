<mujoco model="humanoid_conveyor_workspace">
  <compiler angle="degree" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="Newton" tolerance="1e-10"/>
  
  <default>
    <joint limited="true" armature="0.01" damping="0.5"/>
    <geom contype="1" conaffinity="1" friction="1 0.5 0.5" rgba="0.8 0.6 0.4 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>
  
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.1 0.1" rgb2="0.2 0.2 0.2" width="512" height="512"/>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0 0 0.2" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="10 10" reflectance="0.2"/>
    <material name="belt" rgba="0.2 0.2 0.2 1" reflectance="0.1"/>
    <material name="metal" rgba="0.7 0.7 0.8 1" reflectance="0.8" shininess="0.5"/>
    <material name="plastic" rgba="0.9 0.9 0.9 1" reflectance="0.3"/>
    <material name="red_plastic" rgba="0.9 0.1 0.1 1" reflectance="0.3"/>
    <material name="blue_plastic" rgba="0.1 0.1 0.9 1" reflectance="0.3"/>
    <material name="yellow_plastic" rgba="0.9 0.9 0.1 1" reflectance="0.3"/>
  </asset>
  
  <worldbody>
    <!-- Lighting -->
    <light name="spot1" mode="targetbody" target="conveyor_center" pos="2 -2 3" diffuse="0.8 0.8 0.8"/>
    <light name="spot2" mode="targetbody" target="humanoid_torso" pos="-2 -2 3" diffuse="0.6 0.6 0.6"/>
    <light name="ambient" pos="0 0 5" dir="0 0 -1" diffuse="0.3 0.3 0.3"/>
    
    <!-- Cameras -->
    <camera name="main_camera" pos="3 -3 2.5" xyaxes="0.707 0.707 0 -0.354 0.354 0.866" fovy="45"/>
    <camera name="side_camera" pos="4 0 1.5" xyaxes="0 1 0 0 0 1" fovy="50"/>
    <camera name="top_camera" pos="0 0 5" xyaxes="1 0 0 0 1 0" fovy="60"/>
    <camera name="humanoid_pov" pos="0 -0.8 1.7" xyaxes="0 -1 0 0 0 1" fovy="70"/>
    <camera name="conveyor_closeup" pos="0 1.5 0.8" xyaxes="-1 0 0 0 -0.5 0.866" fovy="40"/>
    
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="5 5 0.1" material="floor" contype="1" conaffinity="1"/>
    
    <!-- Simplified Humanoid -->
    <body name="humanoid_base" pos="0 -1.5 0">
      <!-- Pelvis -->
      <body name="pelvis" pos="0 0 1">
        <joint name="root_x" type="slide" axis="1 0 0" limited="false"/>
        <joint name="root_y" type="slide" axis="0 1 0" limited="false"/>
        <joint name="root_z" type="slide" axis="0 0 1" limited="false"/>
        <joint name="root_roll" type="hinge" axis="1 0 0" limited="false"/>
        <joint name="root_pitch" type="hinge" axis="0 1 0" limited="false"/>
        <joint name="root_yaw" type="hinge" axis="0 0 1" limited="false"/>
        <geom name="pelvis_geom" type="box" size="0.15 0.1 0.1" rgba="0.5 0.5 0.5 1"/>
        
        <!-- Torso -->
        <body name="humanoid_torso" pos="0 0 0.2">
          <joint name="abdomen_y" type="hinge" axis="0 1 0" range="-30 30"/>
          <joint name="abdomen_z" type="hinge" axis="0 0 1" range="-45 45"/>
          <geom name="torso_geom" type="box" size="0.15 0.1 0.25" rgba="0.3 0.3 0.7 1"/>
          
          <!-- Head -->
          <body name="head" pos="0 0 0.35">
            <joint name="neck_y" type="hinge" axis="0 1 0" range="-60 60"/>
            <joint name="neck_z" type="hinge" axis="0 0 1" range="-60 60"/>
            <geom name="head_geom" type="sphere" size="0.1" rgba="0.9 0.7 0.6 1"/>
            <geom name="eye_left" type="sphere" pos="0.05 0.08 0" size="0.02" rgba="0 0 0 1"/>
            <geom name="eye_right" type="sphere" pos="-0.05 0.08 0" size="0.02" rgba="0 0 0 1"/>
          </body>
          
          <!-- Right Arm -->
          <body name="right_shoulder" pos="0.2 0 0.15">
            <joint name="right_shoulder_y" type="hinge" axis="0 1 0" range="-85 60"/>
            <joint name="right_shoulder_z" type="hinge" axis="0 0 1" range="-60 90"/>
            <geom name="right_upper_arm" type="capsule" fromto="0 0 0 0.25 0 0" size="0.04" rgba="0.9 0.7 0.6 1"/>
            
            <body name="right_elbow" pos="0.25 0 0">
              <joint name="right_elbow_y" type="hinge" axis="0 1 0" range="-90 90"/>
              <geom name="right_forearm" type="capsule" fromto="0 0 0 0.2 0 0" size="0.035" rgba="0.9 0.7 0.6 1"/>
              
              <body name="right_hand" pos="0.2 0 0">
                <joint name="right_wrist_y" type="hinge" axis="0 1 0" range="-45 45"/>
                <joint name="right_wrist_z" type="hinge" axis="0 0 1" range="-45 45"/>
                <geom name="right_hand_geom" type="box" size="0.04 0.02 0.08" rgba="0.9 0.7 0.6 1"/>
              </body>
            </body>
          </body>
          
          <!-- Left Arm -->
          <body name="left_shoulder" pos="-0.2 0 0.15">
            <joint name="left_shoulder_y" type="hinge" axis="0 1 0" range="-85 60"/>
            <joint name="left_shoulder_z" type="hinge" axis="0 0 1" range="-90 60"/>
            <geom name="left_upper_arm" type="capsule" fromto="0 0 0 -0.25 0 0" size="0.04" rgba="0.9 0.7 0.6 1"/>
            
            <body name="left_elbow" pos="-0.25 0 0">
              <joint name="left_elbow_y" type="hinge" axis="0 1 0" range="-90 90"/>
              <geom name="left_forearm" type="capsule" fromto="0 0 0 -0.2 0 0" size="0.035" rgba="0.9 0.7 0.6 1"/>
              
              <body name="left_hand" pos="-0.2 0 0">
                <joint name="left_wrist_y" type="hinge" axis="0 1 0" range="-45 45"/>
                <joint name="left_wrist_z" type="hinge" axis="0 0 1" range="-45 45"/>
                <geom name="left_hand_geom" type="box" size="0.04 0.02 0.08" rgba="0.9 0.7 0.6 1"/>
              </body>
            </body>
          </body>
        </body>
        
        <!-- Right Leg -->
        <body name="right_hip" pos="0.1 0 -0.05">
          <joint name="right_hip_x" type="hinge" axis="1 0 0" range="-45 45"/>
          <joint name="right_hip_y" type="hinge" axis="0 1 0" range="-120 20"/>
          <joint name="right_hip_z" type="hinge" axis="0 0 1" range="-45 45"/>
          <geom name="right_thigh" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.05" rgba="0.3 0.3 0.7 1"/>
          
          <body name="right_knee" pos="0 0 -0.4">
            <joint name="right_knee_y" type="hinge" axis="0 1 0" range="0 150"/>
            <geom name="right_shin" type="capsule" fromto="0 0 0 0 0 -0.35" size="0.04" rgba="0.3 0.3 0.7 1"/>
            
            <body name="right_foot" pos="0 0 -0.35">
              <joint name="right_ankle_y" type="hinge" axis="0 1 0" range="-45 45"/>
              <joint name="right_ankle_x" type="hinge" axis="1 0 0" range="-30 30"/>
              <geom name="right_foot_geom" type="box" size="0.06 0.12 0.03" pos="0 0.04 -0.03" rgba="0.2 0.2 0.2 1"/>
            </body>
          </body>
        </body>
        
        <!-- Left Leg -->
        <body name="left_hip" pos="-0.1 0 -0.05">
          <joint name="left_hip_x" type="hinge" axis="1 0 0" range="-45 45"/>
          <joint name="left_hip_y" type="hinge" axis="0 1 0" range="-120 20"/>
          <joint name="left_hip_z" type="hinge" axis="0 0 1" range="-45 45"/>
          <geom name="left_thigh" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.05" rgba="0.3 0.3 0.7 1"/>
          
          <body name="left_knee" pos="0 0 -0.4">
            <joint name="left_knee_y" type="hinge" axis="0 1 0" range="0 150"/>
            <geom name="left_shin" type="capsule" fromto="0 0 0 0 0 -0.35" size="0.04" rgba="0.3 0.3 0.7 1"/>
            
            <body name="left_foot" pos="0 0 -0.35">
              <joint name="left_ankle_y" type="hinge" axis="0 1 0" range="-45 45"/>
              <joint name="left_ankle_x" type="hinge" axis="1 0 0" range="-30 30"/>
              <geom name="left_foot_geom" type="box" size="0.06 0.12 0.03" pos="0 0.04 -0.03" rgba="0.2 0.2 0.2 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
    
    <!-- Conveyor Belt System -->
    <body name="conveyor_center" pos="0 0.5 0">
      <!-- Belt Frame -->
      <geom name="frame_left" type="box" size="0.02 1.5 0.05" pos="-0.52 0 0.4" material="metal"/>
      <geom name="frame_right" type="box" size="0.02 1.5 0.05" pos="0.52 0 0.4" material="metal"/>
      <geom name="frame_front" type="box" size="0.5 0.02 0.05" pos="0 1.48 0.4" material="metal"/>
      <geom name="frame_back" type="box" size="0.5 0.02 0.05" pos="0 -1.48 0.4" material="metal"/>
      
      <!-- Support Structure -->
      <geom name="support_leg1" type="cylinder" fromto="-0.45 1.3 0 -0.45 1.3 0.35" size="0.03" material="metal"/>
      <geom name="support_leg2" type="cylinder" fromto="0.45 1.3 0 0.45 1.3 0.35" size="0.03" material="metal"/>
      <geom name="support_leg3" type="cylinder" fromto="-0.45 -1.3 0 -0.45 -1.3 0.35" size="0.03" material="metal"/>
      <geom name="support_leg4" type="cylinder" fromto="0.45 -1.3 0 0.45 -1.3 0.35" size="0.03" material="metal"/>
      
      <!-- Moving Belt (simplified as sliding platform) -->
      <body name="belt_surface" pos="0 0 0.38">
        <joint name="belt_slide" type="slide" axis="0 1 0" limited="false"/>
        <geom name="belt" type="box" size="0.48 1.45 0.01" material="belt" friction="0.8 0.02 0.01"/>
      </body>
      
      <!-- Control Panel -->
      <body name="control_panel" pos="0.7 0 0.5">
        <geom name="panel_base" type="box" size="0.15 0.2 0.02" material="plastic"/>
        <geom name="button_red" type="cylinder" pos="-0.08 -0.08 0.025" size="0.02 0.01" material="red_plastic"/>
        <geom name="button_blue" type="cylinder" pos="0 -0.08 0.025" size="0.02 0.01" material="blue_plastic"/>
        <geom name="button_yellow" type="cylinder" pos="0.08 -0.08 0.025" size="0.02 0.01" material="yellow_plastic"/>
        <geom name="display" type="box" pos="0 0.05 0.025" size="0.12 0.06 0.005" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
    
    <!-- Objects on Conveyor Belt -->
    <body name="box1" pos="-0.2 0 0.5">
      <joint name="box1_free" type="free"/>
      <geom name="box1_geom" type="box" size="0.08 0.08 0.08" rgba="0.8 0.2 0.2 1" mass="0.5"/>
    </body>
    
    <body name="box2" pos="0.15 -0.5 0.5">
      <joint name="box2_free" type="free"/>
      <geom name="box2_geom" type="box" size="0.06 0.1 0.05" rgba="0.2 0.8 0.2 1" mass="0.3"/>
    </body>
    
    <body name="cylinder1" pos="0 0.3 0.5">
      <joint name="cylinder1_free" type="free"/>
      <geom name="cylinder1_geom" type="cylinder" size="0.05 0.1" rgba="0.2 0.2 0.8 1" mass="0.4"/>
    </body>
    
    <body name="sphere1" pos="0.2 0.8 0.5">
      <joint name="sphere1_free" type="free"/>
      <geom name="sphere1_geom" type="sphere" size="0.06" rgba="0.8 0.8 0.2 1" mass="0.2"/>
    </body>
    
    <!-- Additional Workspace Elements -->
    <body name="tool_rack" pos="-1.5 0 0">
      <geom name="rack_base" type="box" size="0.05 0.3 0.5" material="metal"/>
      <geom name="tool1" type="cylinder" pos="0.08 -0.15 0.3" size="0.02 0.15" rgba="0.5 0.5 0.5 1"/>
      <geom name="tool2" type="cylinder" pos="0.08 0 0.3" size="0.015 0.2" rgba="0.6 0.4 0.2 1"/>
      <geom name="tool3" type="box" pos="0.08 0.15 0.3" size="0.03 0.03 0.1" rgba="0.7 0.7 0.3 1"/>
    </body>
    
    <body name="safety_barrier" pos="1.5 0 0">
      <geom name="barrier_post1" type="cylinder" fromto="0 -1 0 0 -1 0.8" size="0.03" rgba="1 0.8 0 1"/>
      <geom name="barrier_post2" type="cylinder" fromto="0 1 0 0 1 0.8" size="0.03" rgba="1 0.8 0 1"/>
      <geom name="barrier_rail1" type="capsule" fromto="0 -1 0.6 0 1 0.6" size="0.02" rgba="0.1 0.1 0.1 1"/>
      <geom name="barrier_rail2" type="capsule" fromto="0 -1 0.3 0 1 0.3" size="0.02" rgba="0.1 0.1 0.1 1"/>
    </body>
  </worldbody>
  
  <actuator>
    <!-- Belt Motor -->
    <motor name="conveyor_motor" joint="belt_slide" gear="1" ctrllimited="true" ctrlrange="-2 2"/>
    
    <!-- Humanoid Motors (subset for demonstration) -->
    <motor name="abdomen_motor" joint="abdomen_y" gear="50"/>
    <motor name="neck_motor" joint="neck_y" gear="20"/>
    <motor name="right_shoulder_motor" joint="right_shoulder_y" gear="30"/>
    <motor name="right_elbow_motor" joint="right_elbow_y" gear="20"/>
    <motor name="left_shoulder_motor" joint="left_shoulder_y" gear="30"/>
    <motor name="left_elbow_motor" joint="left_elbow_y" gear="20"/>
    <motor name="right_hip_motor" joint="right_hip_y" gear="40"/>
    <motor name="right_knee_motor" joint="right_knee_y" gear="30"/>
    <motor name="left_hip_motor" joint="left_hip_y" gear="40"/>
    <motor name="left_knee_motor" joint="left_knee_y" gear="30"/>
  </actuator>
  
  <sensor>
    <!-- Belt position sensor -->
    <jointpos name="belt_position" joint="belt_slide"/>
    <jointvel name="belt_velocity" joint="belt_slide"/>
    
    <!-- Humanoid sensors -->
    <framepos name="head_position" objtype="body" objname="head"/>
    <framepos name="right_hand_position" objtype="body" objname="right_hand"/>
    <framepos name="left_hand_position" objtype="body" objname="left_hand"/>
    
    <!-- Object detection sensors -->
    <framepos name="box1_position" objtype="body" objname="box1"/>
    <framepos name="box2_position" objtype="body" objname="box2"/>
  </sensor>
</mujoco>