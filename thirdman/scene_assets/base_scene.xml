<mujoco model="base_scene">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <quality shadowsize="4096" offsamples="8"/>
    <map znear="0.01" zfar="80"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1=".35 .45 .60" rgb2="0 0 0" width="512" height="512"/>
    <texture name="tex_checker" type="2d" builtin="checker" rgb1=".85 .85 .85" rgb2=".25 .25 .25" width="600" height="600"/>
    <material name="mat_checker" texture="tex_checker" texrepeat="8 8" reflectance="0.1" specular="0.3" shininess="0.4"/>
  </asset>

  <worldbody>
    <light name="sun" directional="true" castshadow="true"
           pos="3 2 6" dir="-0.45 -0.3 -1"
           diffuse="1 1 1" specular=".5 .5 .5"/>
    <light name="fill" directional="true" castshadow="false"
           pos="-3 -2 3" dir="0.45 0.3 -1"
           diffuse=".35 .35 .35" specular=".1 .1 .1"/>

    <geom name="floor" type="plane" size="40 40 0.1" material="mat_checker"
          contype="1" conaffinity="1"/>

  </worldbody>
</mujoco>
